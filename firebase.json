{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "ignore": ["**/.*"],
    "headers": [
      { "source": "**/*.@(js|css)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ],
    "rewrites": [
      { "source": "/admin", "destination": "/admin.html" },
      { "source": "/admin/**", "destination": "/admin.html" },
      { "source": "/print", "destination": "/print.html" },
      { "source": "**", "destination": "/guest.html" }
    ]
  },
  "functions": [{ "source": "functions", "codebase": "signups", "runtime": "nodejs22" }],
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 5002 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
